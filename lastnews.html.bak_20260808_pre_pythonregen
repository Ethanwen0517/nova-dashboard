<script>

function toggleFilter() {
    var body = document.body;
    var btn  = document.getElementById('filterBtn');
    if (body.classList.contains('filter-new')) {
        body.classList.remove('filter-new');
        btn.classList.remove('active');
        btn.textContent = '🔔 只顯示新增';
    } else {
        body.classList.add('filter-new');
        btn.classList.add('active');
        btn.textContent = '✓ 只顯示新增';
    }
}

var _sortMode = 'stock'; // 'stock' | 'time'

function toggleSort() {
    _sortMode = (_sortMode === 'stock') ? 'time' : 'stock';
    var btn = document.getElementById('sortBtn');
    if (_sortMode === 'stock') {
        btn.textContent = '★ 股票優先';
        btn.classList.add('active');
    } else {
        btn.textContent = '🕐 時間順序';
        btn.classList.remove('active');
    }
    // 對所有 grid 重新排列
    document.querySelectorAll('.news-grid').forEach(function(grid) {
        var cards = Array.from(grid.querySelectorAll('.news-card'));
        if (_sortMode === 'stock') {
            cards.sort(function(a, b) {
                var pa = parseInt(a.dataset.stockOrder) || 999;
                var pb = parseInt(b.dataset.stockOrder) || 999;
                return pa - pb;
            });
        } else {
            cards.sort(function(a, b) {
                var ta = parseInt(a.dataset.timeOrder) || 999;
                var tb = parseInt(b.dataset.timeOrder) || 999;
                return ta - tb;
            });
        }
        // 更新序號顯示
        cards.forEach(function(card, idx) {
            var num = card.querySelector('.news-counter-num');
            if (num) num.textContent = String(idx + 1).padStart(2, '0') + '.';
            grid.appendChild(card);
        });
    });
}

var _focusFilter = null;

function applyFocusFilter(filterVal) {
    var body = document.body;
    document.querySelectorAll('.news-card').forEach(function(c) {
        c.classList.remove('focus-match');
    });
    document.querySelectorAll('.stock-filter-btn').forEach(function(b) {
        b.classList.remove('filter-active');
    });
    if (_focusFilter === filterVal) {
        _focusFilter = null;
        body.classList.remove('focus-filter');
        return;
    }
    _focusFilter = filterVal;
    body.classList.add('focus-filter');
    document.querySelectorAll('.news-card').forEach(function(c) {
        var match = false;
        if (filterVal === 'portfolio') {
            match = c.dataset.stockBadge === 'portfolio';
        } else if (filterVal === 'watchlist') {
            match = c.dataset.stockBadge === 'watchlist';
        } else if (filterVal.indexOf('hl:') === 0) {
            var kw = filterVal.slice(3);
            var hlList = (c.dataset.hl || '').split(',');
            match = hlList.indexOf(kw) !== -1;
        }
        if (match) c.classList.add('focus-match');
    });
    document.querySelectorAll('.stock-filter-btn[data-filter="' + filterVal + '"]')
        .forEach(function(b) { b.classList.add('filter-active'); });
}

function _bindFilterBtns() {
    document.querySelectorAll('.stock-filter-btn').forEach(function(btn) {
        btn.addEventListener('touchend', function(e) {
            e.preventDefault();
            applyFocusFilter(this.dataset.filter);
        }, {passive: false});
        btn.addEventListener('click', function() {
            applyFocusFilter(this.dataset.filter);
        });
    });
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', _bindFilterBtns);
} else {
    _bindFilterBtns();
}


document.addEventListener('mousemove', function(e){var tip=document.getElementById('tip');if(tip&&tip.style.display==='block'){tip.style.left=(e.clientX+15)+'px';tip.style.top=(e.clientY-20)+'px';}});
</script>
