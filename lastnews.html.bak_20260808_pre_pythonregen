<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{
    --theme:#34495e;
    --hover:#e67e22;
    --radius:8px;
    --trans:all 0.3s ease;
}
body{
    font-family:"Microsoft JhengHei","Segoe UI",sans-serif;
    background:#f8f9fa;
    color:#212529;
    padding:10px 14px;
}
.container{width:100%;max-width:100%;margin:0;}
.header{margin-bottom:10px;font-weight:bold;color:var(--theme);}
.summary-bar{
    display:flex;flex-wrap:wrap;gap:8px;
    margin-bottom:14px;padding:12px;
    background:var(--theme);border-radius:var(--radius);
}
.sum-card{
    display:flex;flex-direction:column;align-items:center;
    background:rgba(255,255,255,0.15);border-radius:6px;
    padding:6px 12px;min-width:70px;color:#ffffff;
}
.sum-card.sum-hl{background:rgba(255,255,255,0.28);}
.sum-card.sum-stock-p{background:rgba(232,160,32,0.55);}
.sum-card.sum-stock-w{background:rgba(91,141,217,0.55);}
.sum-label{font-size:0.72em;opacity:0.9;text-align:center;line-height:1.3;}
.sum-num{font-size:1.1em;font-weight:700;margin-top:2px;}
/* 可點擊篩選卡片 */
.stock-filter-btn{
    cursor:pointer;transition:var(--trans);user-select:none;
    touch-action:manipulation;-webkit-tap-highlight-color:rgba(255,255,255,0.3);
}
.stock-filter-btn:hover{transform:scale(1.08);box-shadow:0 0 0 2px #fff;}
.stock-filter-btn.filter-active{outline:3px solid #fff;transform:scale(1.08);}
/* 關注篩選：隱藏不符合的卡片 */
body.focus-filter .news-card{display:none !important;}
body.focus-filter .news-card.focus-match{display:flex !important;}
.stats{
    margin-bottom:12px;padding:10px 14px;
    background:#ecf0f1;border-left:4px solid var(--theme);
    border-radius:4px;font-size:0.9em;color:#333;
}
/* ── Tab 導航 ── */
.tab-nav{
    display:flex;align-items:center;gap:2px;
    margin-bottom:20px;overflow-x:auto;
    padding-bottom:4px;white-space:nowrap;
    -webkit-overflow-scrolling:touch;
    border-bottom:2px solid var(--theme);
}
.tab-btn{
    display:inline-block;padding:4px 8px;
    background:#555;color:#fff;
    text-decoration:none;border-radius:6px 6px 0 0;
    font-weight:600;font-size:0.8em;
    transition:var(--trans);flex-shrink:0;
    border-bottom:3px solid transparent;margin-bottom:-2px;
}
.tab-btn:hover{background:var(--hover);color:#ffffff;}
body:has(#tab_0:target) a[href="#tab_0"] {background:var(--theme);color:#ffffff;border-bottom:3px solid #e67e22;}
body:has(#tab_1:target) a[href="#tab_1"] {background:var(--theme);color:#ffffff;border-bottom:3px solid #e67e22;}
body:has(#tab_2:target) a[href="#tab_2"] {background:var(--theme);color:#ffffff;border-bottom:3px solid #e67e22;}
body:has(#tab_3:target) a[href="#tab_3"] {background:var(--theme);color:#ffffff;border-bottom:3px solid #e67e22;}
body:has(#tab_4:target) a[href="#tab_4"] {background:var(--theme);color:#ffffff;border-bottom:3px solid #e67e22;}
body:has(#tab_5:target) a[href="#tab_5"] {background:var(--theme);color:#ffffff;border-bottom:3px solid #e67e22;}
/* V1.5.2 (2026-08-08): 沒有任何 tab :target 時,預設 Google tab active (第一個 tab) */
body:not(:has(.tab-content:target)) a[href="#tab_0"] {background:var(--theme);color:#ffffff;border-bottom:3px solid #e67e22;}
body:has(#tab_6:target) a[href="#tab_6"] {background:var(--theme);color:#ffffff;border-bottom:3px solid #e67e22;}
body:has(#tab_7:target) a[href="#tab_7"] {background:var(--theme);color:#ffffff;border-bottom:3px solid #e67e22;}
body:has(#tab_8:target) a[href="#tab_8"] {background:var(--theme);color:#ffffff;border-bottom:3px solid #e67e22;}
body:has(#tab_9:target) a[href="#tab_9"] {background:var(--theme);color:#ffffff;border-bottom:3px solid #e67e22;}
body:has(#tab_10:target) a[href="#tab_10"] {background:var(--theme);color:#ffffff;border-bottom:3px solid #e67e22;}
body:has(#tab_11:target) a[href="#tab_11"] {background:var(--theme);color:#ffffff;border-bottom:3px solid #e67e22;}
body:has(#tab_12:target) a[href="#tab_12"] {background:var(--theme);color:#ffffff;border-bottom:3px solid #e67e22;}
body:has(#tab_13:target) a[href="#tab_13"] {background:var(--theme);color:#ffffff;border-bottom:3px solid #e67e22;}
body:has(#tab_14:target) a[href="#tab_14"] {background:var(--theme);color:#ffffff;border-bottom:3px solid #e67e22;}
body:has(#tab_15:target) a[href="#tab_15"] {background:var(--theme);color:#ffffff;border-bottom:3px solid #e67e22;}
body:has(#tab_16:target) a[href="#tab_16"] {background:var(--theme);color:#ffffff;border-bottom:3px solid #e67e22;}
body:has(#tab_17:target) a[href="#tab_17"] {background:var(--theme);color:#ffffff;border-bottom:3px solid #e67e22;}
body:has(#tab_18:target) a[href="#tab_18"] {background:var(--theme);color:#ffffff;border-bottom:3px solid #e67e22;}
body:has(#tab_19:target) a[href="#tab_19"] {background:var(--theme);color:#ffffff;border-bottom:3px solid #e67e22;}body:has(#tab_heatmap:target) a[href="#tab_heatmap"]{background:var(--theme);color:#ffffff;border-bottom:3px solid #e67e22;}
body:has(#tab_cloud:target) a[href="#tab_cloud"]{background:var(--theme);color:#ffffff;border-bottom:3px solid #e67e22;}
.filter-btn{
    display:inline-block;padding:10px 14px;
    background:#ddd;color:#333;
    text-decoration:none;border-radius:6px;
    font-weight:600;font-size:0.9em;
    flex-shrink:0;transition:var(--trans);cursor:pointer;margin-left:8px;
}
.filter-btn:hover{background:var(--hover);color:#fff;}
.filter-btn.active{background:#ff4444;color:#fff;}
.sort-btn{
    display:inline-block;padding:10px 14px;
    background:#ddd;color:#333;
    text-decoration:none;border-radius:6px;
    font-weight:600;font-size:0.9em;
    flex-shrink:0;transition:var(--trans);cursor:pointer;margin-left:4px;
}
.sort-btn:hover{background:var(--hover);color:#fff;}
.sort-btn.active{background:#e8a020;color:#fff;}
/* ── Tab 切換 ── */
.tab-content{display:none;}
#tab_0{display:block;}
.tab-content:target{display:block;}
/* 有任何 tab 被 target 時，隱藏 tab_0（除非 tab_0 自己被選中）*/
body:has(.tab-content:target) #tab_0:not(:target){display:none;}
/* 有任何 tab 被 target 時，一律隱藏 heatmap 和 cloud（除非它們自己被選中）*/
body:has(.tab-content:target) #tab_heatmap:not(:target){display:none !important;}
body:has(.tab-content:target) #tab_cloud:not(:target){display:none !important;}
/* heatmap / cloud 被選中時，隱藏 tab_0 和另一個 */
body:has(#tab_heatmap:target) #tab_0{display:none !important;}
body:has(#tab_cloud:target) #tab_0{display:none !important;}
body:has(#tab_heatmap:target) #tab_cloud{display:none !important;}
body:has(#tab_cloud:target) #tab_heatmap{display:none !important;}
/* heatmap 容器樣式（用 class 而非 inline style，避免覆蓋 display:none）*/
/* V1.5.1 (2026-08-08): 改為白色背景, 配合 #tab_heatmap 內嵌嵌入的淺紫 heatmap 設計 */
.tab-heatmap-wrap{background:#ffffff;min-height:500px;flex-direction:column;align-items:center;justify-content:center;}
#tab_heatmap:target{display:flex;}
/* 摘要列 card 統計按鍵不影響 tab 顯示（純錨點，無 :target 效果）*/
/* ── 過濾 ── */
body.filter-new .news-card[data-is-new="false"]{display:none !important;}
/* ── 格線 ── */
.news-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
    gap:16px;animation:fadeIn 0.3s ease-in;
}
@keyframes fadeIn{
    from{opacity:0;transform:translateY(10px);}
    to{opacity:1;transform:translateY(0);}
}
@media(max-width:768px){
    .news-grid{grid-template-columns:1fr;}
    body{padding:12px;}
    .tab-btn{padding:8px 12px;font-size:0.9em;}
    .sum-card{min-width:60px;padding:5px 8px;}
}
/* ── 卡片 ── */
.news-card{
    background:#ffffff;
    border-radius:var(--radius);
    padding:4px;box-shadow:0 2px 8px rgba(0,0,0,0.1);
    transition:var(--trans);min-height:28px;
    display:flex;flex-direction:column;justify-content:center;
}
.news-card:hover{
    background:#e8f4fd;
    box-shadow:0 4px 16px rgba(0,0,0,0.15);
    transform:translateY(-2px);
}
.news-card.is-new{background:#fffde7;border-left:3px solid var(--theme);}
/* 持股卡片（優先權最高，覆蓋 is-new 的左框色）*/
.news-card.is-portfolio{
    background:#fffbef !important;
    border-left:3px solid #e8a020 !important;
}
/* 觀察清單卡片 */
.news-card.is-watchlist{
    background:#f0f5ff !important;
    border-left:3px solid #5b8dd9 !important;
}
.news-card a{
    text-decoration:none;color:#212529;
    font-weight:500;
    display:flex;align-items:center;gap:6px;flex-wrap:wrap;
    line-height:1.4;word-break:break-word;font-size:0.9em;
}
.news-card a:visited{color:#3498db;}
.news-counter{color:var(--theme);font-size:0.8em;flex-shrink:0;font-weight:600;opacity:0.7;}
.new-badge{
    display:inline-block;background:#ff4444;color:#fff;
    padding:2px 8px;border-radius:12px;font-size:10px;
    font-weight:bold;flex-shrink:0;
}
/* 股票徽章 */
.stock-badge{
    display:inline-block;padding:2px 7px;
    border-radius:10px;font-size:10px;font-weight:bold;flex-shrink:0;
}
.stock-badge-portfolio{background:#e8a020;color:#fff;}
.stock-badge-watchlist{background:#5b8dd9;color:#fff;}
.highlight{font-weight:900 !important;color:#000 !important;}
.empty-state{text-align:center;padding:40px 20px;color:#999;}
.footer{
    text-align:center;margin-top:30px;padding-top:20px;
    border-top:1px solid #ddd;font-size:0.85em;color:#999;
}
/* ── 回頂部 ── */
#backToTop{
    position:fixed;bottom:80px;left:50%;
    transform:translateX(-50%);
    width:50px;height:50px;
    background:var(--theme);color:#fff;
    border-radius:50%;font-size:26px;line-height:50px;
    text-align:center;box-shadow:0 4px 14px rgba(0,0,0,0.3);
    z-index:999;text-decoration:none;opacity:0.85;
}
/* ── 右上角時間戳 ── */
.nova-timestamp{
    position:fixed;top:12px;right:16px;
    background:var(--theme);color:#fff;
    padding:6px 14px;border-radius:20px;
    font-size:0.8em;font-weight:600;
    z-index:9999;box-shadow:0 2px 8px rgba(0,0,0,0.25);
    letter-spacing:0.5px;
}
#backToTop:hover{background:var(--hover);opacity:1;}
</style>
